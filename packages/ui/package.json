{
    "name": "@zyno-io/pixelci-ui",
    "version": "0.6.0",
    "private": true,
    "license": "SEE LICENSE IN LICENSE.md",
    "type": "module",
    "scripts": {
        "dev": "rimraf node_modules/.vite && vite",
        "build": "run-p typecheck build-only",
        "preview": "vite preview",
        "test:unit": "vitest",
        "test:e2e": "playwright test",
        "test:types": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
        "build-only": "vite build",
        "typecheck": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
        "format": "npx oxlint --fix --fix-suggestions --fix-dangerously && oxfmt"
    },
    "dependencies": {
        "@fontsource/inter": "^5.3.0",
        "@fortawesome/fontawesome-free": "^7.3.1",
        "@sentry/browser": "^11.12.0",
        "@sentry/vue": "^11.12.0",
        "@vue/devtools-api": "^8.2.1",
        "@zyno-io/openapi-client-codegen": "^2.11.0",
        "@zyno-io/vue-foundation": "^4.40.0",
        "date-fns": "^4.4.0",
        "lodash": "^4.18.1",
        "openapi-typescript-codegen": "^0.31.0",
        "pinia": "^4.1.0",
        "postinstall-postinstall": "^2.1.0",
        "uuid": "^14.0.3",
        "vue": "^3.5.45",
        "vue-router": "^5.5.1"
    },
    "devDependencies": {
        "@playwright/test": "^1.65.1",
        "@tailwindcss/postcss": "^4.3.5",
        "@tsconfig/node22": "^22.0.7",
        "@types/jsdom": "^30.0.0",
        "@types/lodash": "^4.17.27",
        "@types/node": "^26.6.6",
        "@types/uuid": "^11.0.0",
        "@vitejs/plugin-vue": "^6.0.11",
        "@vue/compiler-dom": "^3.5.45",
        "@vue/test-utils": "^2.6.0",
        "@vue/tsconfig": "^0.9.1",
        "jsdom": "^31.0.1",
        "npm-run-all": "^4.1.5",
        "oxlint": "^1.93.0",
        "postcss": "^8.5.33",
        "rimraf": "^6.1.4",
        "sass": "^1.108.2",
        "tailwindcss": "~4.3.5",
        "type-fest": "^5.10.0",
        "typescript": "npm:typescript-native-bridge@6.0.3-bridge.19.tsgo.7.0.2",
        "vite": "^8.3.8",
        "vite-plugin-oxlint": "^2.2.1",
        "vitest": "^5.1.0",
        "vue-tsc": "^3.3.14"
    }
}
