{
    "name": "@zyno-io/pixelci-ui",
    "version": "0.4.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "rimraf node_modules/.vite && vite",
        "build": "run-p typecheck build-only",
        "preview": "vite preview",
        "test:unit": "vitest",
        "test:e2e": "playwright test",
        "test:types": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
        "build-only": "vite build",
        "typecheck": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
        "format": "npx oxlint --fix --fix-suggestions --fix-dangerously && oxfmt"
    },
    "dependencies": {
        "@fontsource/inter": "^5.3.0",
        "@fortawesome/fontawesome-free": "^7.3.1",
        "@sentry/browser": "^11.4.0",
        "@sentry/vue": "^11.4.0",
        "@vue/devtools-api": "^8.2.1",
        "@zyno-io/openapi-client-codegen": "^2.10.0",
        "@zyno-io/vue-foundation": "^4.37.0",
        "date-fns": "^4.4.0",
        "lodash": "^4.18.1",
        "openapi-typescript-codegen": "^0.31.0",
        "pinia": "^4.0.3",
        "postinstall-postinstall": "^2.1.0",
        "uuid": "^14.0.2",
        "vue": "^3.5.43",
        "vue-router": "^5.3.1"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@tsconfig/node22": "^22.0.6",
        "@types/jsdom": "^30.0.0",
        "@types/lodash": "^4.17.25",
        "@types/node": "^26.6.4",
        "@types/uuid": "^11.0.0",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vue/compiler-dom": "^3.5.43",
        "@vue/test-utils": "^2.5.1",
        "@vue/tsconfig": "^0.9.1",
        "jsdom": "^30.1.2",
        "npm-run-all": "^4.1.5",
        "oxlint": "^1.86.0",
        "postcss": "^8.5.28",
        "rimraf": "^6.1.3",
        "sass": "^1.105.1",
        "tailwindcss": "~4.3.3",
        "type-fest": "^5.10.0",
        "typescript": "npm:typescript-native-bridge@6.0.3-bridge.18.tsgo.7.0.2",
        "vite": "^8.3.2",
        "vite-plugin-oxlint": "^2.2.0",
        "vitest": "^5.0.3",
        "vue-tsc": "^3.3.12"
    }
}
